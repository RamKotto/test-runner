{
  "info": {
    "name": "test-runner",
    "description": "Исполнение тест-кейсов md-to-tests через Playwright/RestAssured + OpenRouter. Обогащение локаторами/URL строго под шагами. Цикл уточнений через /answers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083", "type": "string" },
    { "key": "startUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiBaseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "lastStatus", "value": "", "type": "string" },
    { "key": "sourceRunId", "value": "", "type": "string", "description": "taskId генерации из md-to-test (POST /api/generate); кейсы читаются из БД по этому значению." },
    { "key": "runArtifactId", "value": "", "type": "string", "description": "UUID индекса обогащённых кейсов прогона (последний сегмент enrichedIndexUrl ответа POST /api/run)." }
  ],
  "item": [
    {
      "name": "1. Прогнать все тест-кейсы",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has taskId', () => pm.expect(json.taskId).to.be.a('string').that.is.not.empty);",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "pm.test('outcomes array', () => pm.expect(json.outcomes).to.be.an('array').that.is.not.empty);",
              "pm.collectionVariables.set('taskId', json.taskId);",
              "pm.collectionVariables.set('lastStatus', json.status);",
              "if (json.enrichedIndexUrl) pm.collectionVariables.set('runArtifactId', json.enrichedIndexUrl.split('/').pop());",
              "if (Array.isArray(json.outcomes)) {",
              "  json.outcomes.forEach(o => {",
              "    pm.test('outcome has testCaseId', () => pm.expect(o.testCaseId).to.be.a('string').that.is.not.empty);",
              "    pm.test('outcome status valid', () => pm.expect(o.status).to.be.oneOf(['PASSED','FAILED','SKIPPED','NEEDS_CLARIFICATION']));",
              "    pm.test('enrichments is array', () => pm.expect(o.enrichments).to.be.an('array'));",
              "    if (Array.isArray(o.enrichments)) {",
              "      o.enrichments.forEach(e => {",
              "        pm.test('enrichment has stepIndex', () => pm.expect(e.stepIndex).to.be.a('number').that.is.at.least(0));",
              "        pm.test('enrichment has action', () => pm.expect(e.action).to.be.a('string').that.is.not.empty);",
              "        pm.test('enrichment has detail', () => pm.expect(e.detail).to.be.a('string').that.is.not.empty);",
              "      });",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceRunId\": \"{{sourceRunId}}\",\n  \"startUrl\": \"{{startUrl}}\",\n  \"apiBaseUrl\": \"{{apiBaseUrl}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run"]
        },
        "description": "Читает обогащаемые кейсы из БД по sourceRunId (taskId генерации md-to-test), прогоняет их. Ответ содержит enrichedIndexUrl и archiveUrl. Если status=NEEDS_CLARIFICATION — переходите к шагу 2."
      },
      "response": []
    },
    {
      "name": "1a. Прогон без startUrl (только API)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "pm.collectionVariables.set('taskId', json.taskId);",
              "pm.collectionVariables.set('lastStatus', json.status);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceRunId\": \"{{sourceRunId}}\",\n  \"apiBaseUrl\": \"{{apiBaseUrl}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run"]
        },
        "description": "Только API-кейсы. UI-кейсы, если попадутся, вернут уточнение о недостающем startUrl."
      },
      "response": []
    },
    {
      "name": "1b. SSRF: запрещённый хост → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('mentions host', () => pm.expect(json.message).to.include('Хост не разрешён'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceUrl\": \"http://169.254.169.254/latest/meta-data/tc.md\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run"]
        },
        "description": "SSRF-allowlist: прямая ссылка на .md с чужим хостом → 400 (каталог с чужим хостом даёт 502)."
      },
      "response": []
    },
    {
      "name": "1c. Пустой sourceUrl → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceUrl\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run"]
        },
        "description": "Пустой sourceUrl → 400."
      },
      "response": []
    },
    {
      "name": "2. Ответить на уточнения",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('lastStatus') === 'DONE') {",
              "  console.log('Skipping answers: status=DONE');",
              "  pm.execution.skipRequest();",
              "}",
              "if (!pm.collectionVariables.get('taskId')) {",
              "  console.log('Skipping answers: no taskId');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));",
              "pm.collectionVariables.set('lastStatus', json.status);",
              "if (json.enrichedIndexUrl) pm.collectionVariables.set('runArtifactId', json.enrichedIndexUrl.split('/').pop());",
              "if (json.status === 'DONE') {",
              "  pm.collectionVariables.unset('taskId');",
              "}",
              "if (Array.isArray(json.outcomes)) {",
              "  json.outcomes.forEach(o => {",
              "    pm.expect(o.status).to.be.oneOf(['PASSED','FAILED','SKIPPED','NEEDS_CLARIFICATION']);",
              "    pm.expect(o.enrichments).to.be.an('array');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    {\n      \"question\": \"[ui_locator_button] Шаг 4 («Нажать кнопку оплаты»): уточните локатор кнопки\",\n      \"answer\": \"Кнопка имеет id='pay-btn', класс 'btn-primary', текст 'Оплатить'\",\n      \"topicKey\": \"ui_locator_button\"\n    },\n    {\n      \"question\": \"[api_base_url] Укажите базовый URL API\",\n      \"answer\": \"http://localhost:3000/api\",\n      \"topicKey\": \"api_base_url\"\n    }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run/{{taskId}}/answers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run", "{{taskId}}", "answers"]
        },
        "description": "Отправляет ответы на clarifications. topicKey берётся из поля clarifications ответа шага 1 (тексты и темы в примере — образцы). Прогон продолжится с того же тест-кейса. Обогащение появится под шагом, где было уточнение."
      },
      "response": []
    },
    {
      "name": "2a. Ответ на истёкшую сессию → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('mentions session', () => pm.expect(json.message).to.include('Сессия не найдена'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"question\": \"x\", \"answer\": \"y\" }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run/00000000-0000-0000-0000-000000000000/answers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run", "00000000-0000-0000-0000-000000000000", "answers"]
        },
        "description": "Несуществующий taskId → 400 'Сессия не найдена или истекла'."
      },
      "response": []
    },
    {
      "name": "2b. Состояние сессии уточнений",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has version', () => pm.expect(json.version).to.be.a('number'));",
              "pm.test('status valid', () => pm.expect(json.status).to.be.oneOf(['DONE','NEEDS_CLARIFICATION']));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/run/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run", "{{taskId}}"]
        },
        "description": "Состояние сессии уточнений прогона из БД: status, version, round, clarifications, answers, draft и последний ответ (outcomes, enrichedIndexUrl, archiveUrl). Срок хранения 30 дней."
      },
      "response": []
    },
    {
      "name": "2c. Черновик ответов",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"draft\":{\"0\":\"черновик ответа\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run/{{taskId}}/draft",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run", "{{taskId}}", "draft"]
        },
        "description": "Сохраняет черновик ответов на уточнения прогона: draft перезаписывается целиком, version не меняется. Ответ 204."
      },
      "response": []
    },
    {
      "name": "2d. Ответ с устаревшей версией → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('mentions version conflict', () => pm.expect(pm.response.json().message).to.include('Сессия уже изменена'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"answers\":[{\"question\":\"x\",\"answer\":\"y\",\"topicKey\":\"z\"}],\"expectedVersion\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/run/{{taskId}}/answers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "run", "{{taskId}}", "answers"]
        },
        "description": "Передаёт expectedVersion=0, который не совпадает с текущей version сессии → 409 «Сессия уже изменена в другом окне. Обновите страницу.». Тест рассчитан на сессию с version больше 0."
      },
      "response": []
    },
    {
      "name": "3. Скачать индекс обогащённых кейсов прогона",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('runArtifactId')) {",
              "  console.log('Skipping download: no artifactId');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('content-type markdown', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/markdown'));",
              "pm.test('content-disposition attachment', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));",
              "const body = pm.response.text();",
              "pm.test('has Шаги', () => pm.expect(body).to.include('## Шаги'));",
              "pm.test('has enrichment marker', () => pm.expect(body).to.match(/> (?:🔍|📸|⚖️|⏭)/u));",
              "pm.test('has Ожидаемый результат', () => pm.expect(body).to.include('## Ожидаемый результат'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{runArtifactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "{{runArtifactId}}"]
        },
        "description": "Скачивает индекс обогащённых кейсов прогона из БД по UUID (runArtifactId = последний сегмент enrichedIndexUrl ответа /api/run). Под каждым шагом выводится блок-цитата с маркером: 🔍 (действие), 📸 SNAPSHOT, ⚖️ COMPARE или ⏭ SKIP (каскад)."
      },
      "response": []
    },
    {
      "name": "3a. Path traversal → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/files/..%2F..%2Fetc%2Fpasswd",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "..%2F..%2Fetc%2Fpasswd"]
        },
        "description": "Path traversal (..%2F..%2Fetc%2Fpasswd) вместо UUID: некорректный UUID → 400."
      },
      "response": []
    },
    {
      "name": "3b. Архив обогащённых кейсов прогона (ZIP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('content-disposition attachment', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/files/runs/{{taskId}}/archive",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "runs", "{{taskId}}", "archive"]
        },
        "description": "ZIP со всеми обогащёнными файлами прогона (taskId). Адрес также приходит в поле archiveUrl ответа POST /api/run. Ответ — вложение (Content-Disposition: attachment)."
      },
      "response": []
    },
    {
      "name": "4. Healthcheck",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        },
        "description": "Проверка состояния приложения."
      },
      "response": []
    }
  ]
}
